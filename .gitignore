# 工作区记忆/IDE 垃圾，禁止入库
.workbuddy/
.DS_Store
Thumbs.db
*.tmp
*.bak

# Python 缓存
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 环境变量
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/

# 跨工具生成文件（由 sync_rules.py 按 profile 生成，不入库）
# 克隆后运行: python scripts/sync_rules.py --profile <id> --tool <tool>
# 注意：必须用 /AGENTS.md 锚定仓库根，否则会静默忽略 personas/*/AGENTS.md（场景协议源文件）
/AGENTS.md
# 例外：根 AGENTS.md 是项目产品展示 + 测试夹具，需入库（CI 会校验新鲜度）
!/AGENTS.md
/CLAUDE.md
/GEMINI.md
/.cursor/rules/
/.github/copilot-instructions.md
/.github/instructions/
/.trae/rules/
/.windsurfrules
/.clinerules/
/.continue/rules/
/.amazonq/rules/
/best_practices.md
.lingma/rules/
.comate/rules/
/.codex/rules.md
provenance/

# 限长平台分片目录（由 sync_rules.py 在 skeleton 模式自动分片生成）
.windsurfrules.d/
.clinerules.d/
.lingma/rules.d/
.comate/rules.d/

# Python 构建产物（pip build / wheel）
dist/
build/
*.whl
*.egg-info/

# setup.py 构建时自动生成（从 core/personas/capabilities/adapters 同步，不入库）
src/agentseed/_resources/
